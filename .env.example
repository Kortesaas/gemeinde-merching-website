# =============================================================================
# Gemeinde Merching – environment configuration (TEMPLATE)
#
# Copy to .env and fill in. NEVER commit .env. This file must not contain real
# credentials. Production values: see docs/deployment-goneo.md.
# =============================================================================

APP_NAME="Gemeinde Merching"
# local | testing | staging | production
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
# MUST be false in production (enforced by the application anyway).
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE
APP_MAINTENANCE_DRIVER=file

# Internal/database timestamps are always UTC. This zone is used for every
# date/time citizens and editors see or enter (incl. publishing/expiry).
SITE_TIMEZONE=Europe/Berlin

# --- Search engines ----------------------------------------------------------
# Indexing only happens with APP_ENV=production AND PUBLIC_INDEXING=true.
PUBLIC_INDEXING=false

# --- Backend -----------------------------------------------------------------
ADMIN_PATH=verwaltung
# Two-factor authentication for backend accounts. Keep true; may be set to
# false for local development only.
MFA_REQUIRED=true
ADMIN_SESSION_ABSOLUTE_LIFETIME=600

# --- Audit log ---------------------------------------------------------------
# Retention of audit events in days (provisional, to be confirmed with the
# Datenschutzbeauftragte). 0 disables automatic deletion.
AUDIT_RETENTION_DAYS=730

# --- Content revisions -------------------------------------------------------
# Retention not decided yet: unset = keep all revisions.
# REVISION_RETENTION_DAYS=
REVISION_KEEP_LATEST=20

# --- HTTP security -----------------------------------------------------------
# Defaults: HTTPS redirect + HSTS in production only.
# FORCE_HTTPS=true
# HSTS_INCLUDE_SUBDOMAINS=false
# Comma-separated host names (default: host of APP_URL).
# TRUSTED_HOSTS=www.gemeinde-merching.de
# Alias hosts redirected (301, path kept) to the APP_URL host, e.g. non-www.
# REDIRECT_HOSTS=gemeinde-merching.de
# Only if behind a reverse proxy: comma-separated IPs/CIDRs.
# TRUSTED_PROXIES=

# --- Hashing -----------------------------------------------------------------
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
# Production: LOG_STACK=daily, LOG_LEVEL=warning
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# --- Database (MySQL) --------------------------------------------------------
# Native setup: your local MySQL. Docker setup: DB_HOST/DB_PORT are overridden
# by compose.yaml; DB_PASSWORD is any local-only value you choose.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=merching
DB_USERNAME=merching
DB_PASSWORD=

# --- Sessions (server-side in MySQL) -----------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true in production (enforced there).
# SESSION_SECURE_COOKIE=true

# --- Cache / queue (no Redis, no worker) ---------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null
FILESYSTEM_DISK=local

# --- Mail ----------------------------------------------------------------------
# Local: Mailpit from compose.yaml (http://localhost:8025).
# Production: SMTP of the goneo mailbox (credentials only in the server .env).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Docker development only -------------------------------------------------
APP_PORT=8088
FORWARD_DB_PORT=33060
FORWARD_MAILPIT_DASHBOARD_PORT=8025
